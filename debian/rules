#!/usr/bin/make -f

export CMAKE_PREFIX_PATH := /home/walter/Qt/6.9.3/gcc_64

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=/opt/dispensa \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DDISPENSA_DEPLOY_QT=ON

override_dh_auto_install:
	dh_auto_install
	mkdir -p debian/dispensa/opt/dispensa/plugins/wayland-shell-integration
	cp -a /home/walter/Qt/6.9.3/gcc_64/plugins/wayland-shell-integration/*.so debian/dispensa/opt/dispensa/plugins/wayland-shell-integration/
	mkdir -p debian/dispensa/opt/dispensa/lib
	cp -a /home/walter/Qt/6.9.3/gcc_64/lib/libQt6WaylandClient.so* debian/dispensa/opt/dispensa/lib/
	cp -a /home/walter/Qt/6.9.3/gcc_64/lib/libQt6WaylandEglClientHwIntegration.so* debian/dispensa/opt/dispensa/lib/
	cp -a /home/walter/Qt/6.9.3/gcc_64/lib/libQt6WlShellIntegration.so* debian/dispensa/opt/dispensa/lib/
	install -D -m 644 /home/walter/Qt/6.9.3/gcc_64/plugins/platforms/libqwayland-generic.so debian/dispensa/opt/dispensa/plugins/platforms/libqwayland-generic.so
	install -D -m 644 /home/walter/Qt/6.9.3/gcc_64/plugins/platforms/libqwayland-egl.so debian/dispensa/opt/dispensa/plugins/platforms/libqwayland-egl.so

override_dh_shlibdeps:
	rm -f debian/dispensa/opt/dispensa/plugins/sqldrivers/libqsqlpsql.so
	rm -f debian/dispensa/opt/dispensa/plugins/sqldrivers/libqsqlodbc.so
	rm -f debian/dispensa/opt/dispensa/plugins/sqldrivers/libqsqlmysql.so
	rm -f debian/dispensa/opt/dispensa/plugins/sqldrivers/libqsqlmimer.so
	dh_shlibdeps -- --ignore-missing-info

%:
	dh $@ --buildsystem=cmake
